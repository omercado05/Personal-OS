# ============================================================================
# Personal OS — plantilla de variables de entorno
#
#   cp .env.example .env      # y ajusta los valores
#
# NUNCA subas el `.env` real al repositorio: contiene secretos.
# El comando `docker compose` lee automáticamente el archivo `.env`.
# ============================================================================

# --- Aplicación -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
# La imagen del frontend recibe además estas variables públicas de Hexclave,
# derivadas de las de Hexclave de más abajo (ver docker-compose.yml):
#   NEXT_PUBLIC_HEXCLAVE_API_URL
#   NEXT_PUBLIC_HEXCLAVE_PROJECT_ID
#   NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY
# Solo necesitas definirlas aparte si ejecutas el frontend fuera de Docker
# (`pnpm dev` en frontend/, p. ej. en frontend/.env.local).

# Backend (Fastify)
CORS_ORIGIN=http://localhost:3000

# --- Base de datos de la aplicación (MySQL) ---------------------------------
MYSQL_DATABASE=personal_os
MYSQL_USER=personal_os
MYSQL_PASSWORD=cambia-esta-password-app
MYSQL_ROOT_PASSWORD=cambia-esta-password-root

# --- Backend / Prisma -------------------------------------------------------
# Acceso desde el host, para `pnpm dev` y las migraciones de Prisma.
# Dentro de Docker Compose, el contenedor `backend` sobreescribe DATABASE_URL
# con el hostname interno `mysql`. Ajusta usuario/password a los de arriba.
DATABASE_URL=mysql://personal_os:cambia-esta-password-app@127.0.0.1:3306/personal_os
# Solo lo usa `prisma migrate dev` para crear/borrar la base de datos "shadow".
# Debe usar un usuario con privilegios para crear y eliminar bases de datos.
SHADOW_DATABASE_URL=mysql://root:cambia-esta-password-root@127.0.0.1:3306/personal_os_shadow

# --- Hexclave (Stack Auth) self-hosted --------------------------------------
# URLs públicas, accesibles desde el navegador.
HEXCLAVE_PUBLIC_API_URL=http://localhost:8102
HEXCLAVE_PUBLIC_DASHBOARD_URL=http://localhost:8101
# URL interna (server-to-server dentro de la red de Docker).
HEXCLAVE_INTERNAL_API_URL=http://hexclave-server:8102
# Proxy de confianza: déjalo vacío en local (HTTP). Usa "generic" detrás de un
# reverse proxy en producción.
HEXCLAVE_TRUSTED_PROXY=

# Proyecto de la aplicación. Se crea en el dashboard self-hosted
# (http://localhost:8101) y luego se copian aquí sus claves.
HEXCLAVE_PROJECT_ID=
HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
HEXCLAVE_SECRET_SERVER_KEY=

# Verificación del JWT en el backend. Normalmente NO hace falta definirlas: se
# derivan de HEXCLAVE_PROJECT_ID + las URLs de la API. Sobreescríbelas solo si
# tu despliegue lo requiere (ver DEVELOPMENT_PLAN.md §8.3).
#   HEXCLAVE_ISSUER   = <HEXCLAVE_PUBLIC_API_URL>/api/v1/projects/<project id>
#   HEXCLAVE_AUDIENCE = <project id>
#   HEXCLAVE_JWKS_URL = <HEXCLAVE_INTERNAL_API_URL o público>/api/v1/projects/<project id>/.well-known/jwks.json
HEXCLAVE_ISSUER=
HEXCLAVE_AUDIENCE=
HEXCLAVE_JWKS_URL=

# --- Base de datos de Hexclave (PostgreSQL 15+) -----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-password-postgres
POSTGRES_DB=stackframe

# --- ClickHouse (analytics de Hexclave) -------------------------------------
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=stackframe
CLICKHOUSE_PASSWORD=cambia-esta-password-clickhouse
STACK_CLICKHOUSE_EXTERNAL_PASSWORD=cambia-esta-password-clickhouse-external

# --- Secretos de Hexclave (generar y MANTENER estables) ----------------------
# STACK_SERVER_SECRET:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Resto de valores:     openssl rand -hex 32
STACK_SERVER_SECRET=cambia-este-secreto-de-32-bytes-base64url
CRON_SECRET=cambia-este-secreto-largo-y-aleatorio
STACK_INTERNAL_PROJECT_PUBLISHABLE_CLIENT_KEY=cambia-esta-clave
STACK_INTERNAL_PROJECT_SECRET_SERVER_KEY=cambia-esta-clave
STACK_SEED_INTERNAL_PROJECT_SUPER_SECRET_ADMIN_KEY=cambia-esta-clave

# --- Usuario administrador sembrado por Hexclave ----------------------------
STACK_SEED_INTERNAL_PROJECT_USER_EMAIL=admin@example.com
STACK_SEED_INTERNAL_PROJECT_USER_PASSWORD=cambia-esta-password-admin
STACK_SEED_INTERNAL_PROJECT_USER_INTERNAL_ACCESS=true
STACK_SEED_INTERNAL_PROJECT_SIGN_UP_ENABLED=false
